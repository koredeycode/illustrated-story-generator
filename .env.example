# Copy to .env (same dir as this file, or repo root) and fill in.
# NEVER commit .env — it holds secrets. See R2 setup in chat/roadmap.
#
# Local dev:  set -a; source backend/.env; set +a
# Kaggle:     prefer Add-ons > Secrets (auto-injected as env vars).

# --- model services (defaults work on Kaggle) ---
OLLAMA_URL=http://127.0.0.1:11434
FORGE_URL=http://127.0.0.1:7860
LLM_MODEL=qwen3:8b

# --- storage ---
DATA_DIR=./books
PORT=8000

# --- Cloudflare R2 (optional; local-only mode when empty) ---
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_KEY=
R2_SECRET=
R2_BUCKET=storybooks

# --- generation tuning (all optional) ---
# HERO_SCORE_MIN=0.23
# HERO_REROLLS=2
# IP_ADAPTER_WEIGHT=0.7
# AUDIOBOOK_VOICE=en-US-AriaNeural
# HERO_CLIP_MODEL=openai/clip-vit-base-patch32
